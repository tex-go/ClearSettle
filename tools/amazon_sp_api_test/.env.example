# ─────────────────────────────────────────────────────────────────────────────
# ClearSettle — Amazon SP-API Test Harness
# Environment Variables
#
# Copy this file to .env and fill in your actual credentials:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────


# ── LWA (Login with Amazon) — from Seller Central Developer Console ──────────

# Your SP-API app's OAuth client ID.
# Format: amzn1.application-oa2-client.<32 hex chars>
# Found at: Seller Central → Apps & Services → Develop Apps → Edit App → Credentials
LWA_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your SP-API app's OAuth client secret.
# Found at: same location as LWA_CLIENT_ID (click "Show" to reveal)
LWA_CLIENT_SECRET=amzn1.oa2-cs.v1.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Long-lived refresh token obtained after authorising the app.
# Self-authorisation: Seller Central → Apps → Authorise your own app
# Third-party: obtained via the OAuth flow (seller grants access)
# Format starts with: Atzr| or Atza|
LWA_REFRESH_TOKEN=Atzr|IwEBIxxxxxx...


# ── AWS IAM Credentials ───────────────────────────────────────────────────────

# IAM user or role access key ID.
# Format: AKIA... (long-term) or ASIA... (temporary / STS)
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE

# IAM user secret access key.
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# (Optional) IAM role ARN to assume before calling SP-API.
# Use when following least-privilege patterns — the IAM user above assumes this role.
# If not set, the AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY above are used directly.
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/ClearSettle-SP-API-Role

# AWS region for SigV4 signing. Auto-detected from SP_API_ENDPOINT if not set.
#   India (EU region) → eu-west-1
#   North America     → us-east-1
#   Far East          → us-west-2
AWS_REGION=eu-west-1


# ── SP-API Endpoint ───────────────────────────────────────────────────────────

# Production endpoints (use after testing):
#   India / EU:       https://sellingpartnerapi-eu.amazon.com
#   North America:    https://sellingpartnerapi-na.amazon.com
#   Far East (Japan): https://sellingpartnerapi-fe.amazon.com
#
# Sandbox endpoints (safe for testing — start here):
#   India / EU:       https://sandbox.sellingpartnerapi-eu.amazon.com
#   North America:    https://sandbox.sellingpartnerapi-na.amazon.com
#   Far East:         https://sandbox.sellingpartnerapi-fe.amazon.com

SP_API_ENDPOINT=https://sandbox.sellingpartnerapi-eu.amazon.com
