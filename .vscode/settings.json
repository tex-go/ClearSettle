{
  // ── Flutter / Dart ─────────────────────────────────────────────────────────
  "dart.flutterSdkPath": null,           // auto-detect from PATH
  "dart.previewFlutterUiGuides": true,   // widget tree guides in editor
  "dart.debugExternalPackageLibraries": false,
  "dart.debugSdkLibraries": false,

  // ── Debug Console output ───────────────────────────────────────────────────
  // Show ALL flutter log output including debugPrint + developer.log
  "dart.openDevTools": "flutter",        // auto-open Flutter DevTools on launch
  "debug.console.fontSize": 13,
  "debug.console.lineHeight": 20,
  "debug.inlineValues": true,

  // ── Editor: highlight ClearSettle log tags ─────────────────────────────────
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "comment",
        "settings": { "foreground": "#6A9955" }
      }
    ]
  },

  // ── Output panel ──────────────────────────────────────────────────────────
  "flutter.openDevLog": true,

  // ── File associations ─────────────────────────────────────────────────────
  "files.associations": {
    "*.dart": "dart"
  },

  // ── Exclude noise from explorer ───────────────────────────────────────────
  "files.exclude": {
    "**/.dart_tool": true,
    "**/build": true,
    "**/.flutter-plugins": true,
    "**/.flutter-plugins-dependencies": true,
    "**/.packages": true
  }
}
