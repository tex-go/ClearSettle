# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# Amazon SP-API credentials (obtain from Amazon Developer Console)
SP_API_CLIENT_ID=amzn1.application-oa2-client.REPLACE_ME
SP_API_CLIENT_SECRET=amzn1.oa2-cs.v1.REPLACE_ME
SP_API_REFRESH_TOKEN=Atzr|REPLACE_ME

# ClearSettle local dev
CLEARSETTLE_URL=http://localhost:8000
CLEARSETTLE_EMAIL=your@email.com
CLEARSETTLE_PASSWORD=your_password
