# ============================================================
# ClearSettle Production Environment Variables
# Copy to .env.prod and fill in real values before deploying.
# NEVER commit .env.prod to git.
# ============================================================

# ── Docker image registry ────────────────────────────────────────────────────
REGISTRY=ghcr.io/your-org
IMAGE_TAG=latest

# ── App domain ───────────────────────────────────────────────────────────────
FRONTEND_URL=https://clearsettle.in
ALLOWED_ORIGINS=https://clearsettle.in,https://www.clearsettle.in
BACKEND_URL=https://clearsettle.in

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://clearsettle_user:STRONG_PASSWORD@db-host:5432/clearsettle_prod

# ── Security ─────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_HEX

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── Super Admin (seeded in migration 033) ────────────────────────────────────
# IMPORTANT: Change these from defaults before running alembic upgrade head
SUPER_ADMIN_EMAIL=Admin@clearsettle.com
SUPER_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
SUPER_ADMIN_NAME=ClearSettle Admin

# ── Amazon SP-API ─────────────────────────────────────────────────────────────
SP_API_APP_ID=amzn1.sellerapps.app.REPLACE
SP_API_CLIENT_ID=amzn1.application-oa2-client.REPLACE
SP_API_CLIENT_SECRET=REPLACE
SP_API_REDIRECT_URI=https://clearsettle.in/marketplace/oauth/callback
SP_API_MARKETPLACE_ID=A21TJRUUN4KGV
SP_API_REGION=eu
SP_API_ENDPOINT=https://sellingpartnerapi-eu.amazon.com

# ── Shopify (optional — only if connecting Shopify stores) ────────────────────
SHOPIFY_API_KEY=REPLACE
SHOPIFY_API_SECRET=REPLACE
SHOPIFY_REDIRECT_URI=https://clearsettle.in/marketplace/oauth/callback

# ── AI / Seller Discovery (optional) ────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Storage (optional — GCS uploads) ─────────────────────────────────────────
GCS_UPLOADS_BUCKET=
