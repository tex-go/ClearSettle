# ============================================================
# ClearSettle Production Environment Variables
# Copy to .env and fill in real values before deploying.
# NEVER commit .env to git — it is in .gitignore.
#
# URL routing (nginx strips /api prefix):
#   http://clearsettle.in/api/<path>  →  backend container /<path>
#   http://clearsettle.in/<path>      →  frontend container
# ============================================================

# ── Docker image registry ────────────────────────────────────────────────────
REGISTRY=ghcr.io/your-org
IMAGE_TAG=latest

# ── App domain ───────────────────────────────────────────────────────────────
FRONTEND_URL=http://clearsettle.in
BACKEND_URL=http://clearsettle.in
ALLOWED_ORIGINS=http://clearsettle.in,http://www.clearsettle.in

# ── Database (Postgres runs as a container in docker-compose.prod.yml) ───────
POSTGRES_DB=clearsettle
POSTGRES_USER=clearsettle_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── Security ─────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_HEX

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── Super Admin (seeded in migration 033) ────────────────────────────────────
SUPER_ADMIN_EMAIL=Admin@clearsettle.com
SUPER_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
SUPER_ADMIN_NAME=ClearSettle Admin

# ══════════════════════════════════════════════════════════════════════════════
# ECOMMERCE OAUTH CONNECTORS
#
# Callback URL pattern for ALL server-mediated connectors:
#   http://clearsettle.in/api/<platform>/callback
#   (nginx strips /api → backend receives /<platform>/callback)
#
# Flipkart is an exception — its OAuth is browser-direct from the mobile app;
# the redirect URI is a deep link (clearsettle://oauth/flipkart/callback),
# not a server URL.
# ══════════════════════════════════════════════════════════════════════════════

# ── Amazon SP-API ─────────────────────────────────────────────────────────────
# Register at: https://solutionproviderportal.amazon.com → Developer Central
# Redirect URI to register: http://clearsettle.in/api/sp-api/callback
SP_API_APP_ID=amzn1.sellerapps.app.REPLACE
SP_API_CLIENT_ID=amzn1.application-oa2-client.REPLACE
SP_API_CLIENT_SECRET=REPLACE
SP_API_REDIRECT_URI=http://clearsettle.in/api/sp-api/callback
SP_API_MARKETPLACE_ID=A21TJRUUN4KGV
SP_API_REGION=eu
# Production API endpoint (switch from sandbox once testing is complete):
SP_API_ENDPOINT=https://sellingpartnerapi-eu.amazon.com

# ── Flipkart ──────────────────────────────────────────────────────────────────
# Register at: https://seller.flipkart.com/api-docs/FMSAPI.html
# Mobile deep link redirect — register clearsettle://oauth/flipkart/callback
# in the Flipkart Partner Console (not a server URL).
FLIPKART_CLIENT_ID=REPLACE
FLIPKART_CLIENT_SECRET=REPLACE

# ── Shopify (future) ──────────────────────────────────────────────────────────
# Register at: https://partners.shopify.com → Apps → Create App
# Redirect URI to register: http://clearsettle.in/api/shopify/callback
SHOPIFY_API_KEY=REPLACE
SHOPIFY_API_SECRET=REPLACE
SHOPIFY_REDIRECT_URI=http://clearsettle.in/api/shopify/callback
SHOPIFY_SCOPES=read_orders,read_finances,read_products,read_inventory

# ── Meesho (future — manual upload only, no OAuth required) ──────────────────
# No OAuth credentials needed. Sellers export reports from Meesho dashboard.

# ── Myntra (future — manual upload only, no OAuth required) ──────────────────
# No OAuth credentials needed. Sellers export reports from Myntra dashboard.

# ── Ajio (future — manual upload only, no OAuth required) ────────────────────
# No OAuth credentials needed. Sellers export reports from Ajio dashboard.

# ── AI / Seller Discovery (optional) ─────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Storage (optional — GCS uploads) ─────────────────────────────────────────
GCS_UPLOADS_BUCKET=
